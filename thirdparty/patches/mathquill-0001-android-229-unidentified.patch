From c98661c9b7c244de26ea678e71c2d609e78d9e3f Mon Sep 17 00:00:00 2001
From: Ralf Erlebach <ralf.erlebach@gmx.de>
Date: Thu, 8 Oct 2026 09:22:26 +0200
Subject: [PATCH] Keep soft-keyboard text after a 229 'Unidentified' keydown

Android soft keyboards send keydown key="Unidentified", keyCode 229 before
every character. The ChromeOS Ctrl-Shift-U guard in typedText() swallowed
those characters. The guard now matches the Unicode entry only: Ctrl-Shift
with U/Process/Unidentified, or a bare Unidentified without keyCode 229.
Unit tests cover 229 input, ordering, and both suppressed ChromeOS cases.
---
 src/services/saneKeyboardEvents.util.ts | 41 ++++++++++----
 test/unit/androidInput.test.js          | 71 +++++++++++++++++++++++++
 2 files changed, 102 insertions(+), 10 deletions(-)

diff --git a/src/services/saneKeyboardEvents.util.ts b/src/services/saneKeyboardEvents.util.ts
index 8c9f5a1d..b1a3c1f8 100644
--- a/src/services/saneKeyboardEvents.util.ts
+++ b/src/services/saneKeyboardEvents.util.ts
@@ -95,6 +95,29 @@ var saneKeyboardEvents = (function () {
     ' ': 'Spacebar'
   };
 
+  /**
+   * Whether a keydown belongs to Chrome's Ctrl-Shift-U Unicode entry (Linux, ChromeOS), whose
+   * input event must not be taken as typed text.
+   *
+   * keyCode 229 marks a key an IME is processing - the keydown an Android soft keyboard sends
+   * before every character. It is never part of the Unicode entry, so such a keydown is not
+   * matched even when its key is "Unidentified".
+   */
+  function isUnicodeEntryKeydown(keydown: KeyboardEvent) {
+    if (
+      !keydown.altKey &&
+      keydown.ctrlKey &&
+      !keydown.metaKey &&
+      keydown.shiftKey &&
+      (keydown.key === 'U' ||
+        keydown.key === 'Process' ||
+        keydown.key === 'Unidentified')
+    ) {
+      return true;
+    }
+    return keydown.key === 'Unidentified' && keydown.keyCode !== 229;
+  }
+
   function isArrowKey(e: KeyboardEvent) {
     // The keyPress event in FF reports which=0 for some reason. The new
     // .key property seems to report reasonable results, so we're using that
@@ -292,16 +315,14 @@ var saneKeyboardEvents = (function () {
       // Furthermore, an input event with the value "u" is still processed in Linux and Chrome OS due to the down/up mismatch.
       // The end result is that a spurious "u" is sent followed by the intended character.
       // Due to how this feature works, it's vital to completely ignore Ctrl-Shift-U no matter how the input event appears to Mathquill as clearing the textarea by mistake breaks the expected input flow.
-      if (
-        keydown &&
-        (keydown.key === 'Unidentified' ||
-          (!keydown.altKey &&
-            keydown.ctrlKey &&
-            !keydown.metaKey &&
-            keydown.shiftKey &&
-            (keydown.key === 'U' || keydown.key === 'Process')))
-      )
-        return;
+      //
+      // A bare "Unidentified" keydown is not only that ChromeOS quirk, though: soft keyboards on
+      // Android send keydown key="Unidentified" with keyCode 229 ("the IME is processing this
+      // key") before every character they deliver. Ignoring those dropped the character and left
+      // it in the textarea, where the next character turned it into a two-character value that
+      // was never inserted either. keyCode 229 is the IME marker and never part of the
+      // Ctrl-Shift-U sequence, so a bare "Unidentified" is ignored only without it.
+      if (keydown && isUnicodeEntryKeydown(keydown)) return;
       if (text.length === 1) {
         textarea.value = '';
         if (controller.options && controller.options.overrideTypedText) {
diff --git a/test/unit/androidInput.test.js b/test/unit/androidInput.test.js
index 6075c35a..546a29d8 100644
--- a/test/unit/androidInput.test.js
+++ b/test/unit/androidInput.test.js
@@ -139,4 +139,75 @@ suite('text entry without a keypress', function () {
       assert.equal(mq.latex(), 'ab');
     });
   });
+
+  function keyEvent(type, key, keyCode, modifiers) {
+    const event = new KeyboardEvent(
+      type,
+      Object.assign({ bubbles: true, key: key }, modifiers || {})
+    );
+    // keyCode is not part of the standard KeyboardEventInit everywhere; set it directly.
+    Object.defineProperty(event, 'keyCode', { value: keyCode });
+    Object.defineProperty(event, 'which', { value: keyCode });
+    return event;
+  }
+
+  function softKey(character, keyCode, modifiers) {
+    // keydown "Unidentified", the browser's own text insertion, keyup.
+    const el = textarea();
+    el.dispatchEvent(keyEvent('keydown', 'Unidentified', keyCode, modifiers));
+    el.value = el.value + character;
+    el.dispatchEvent(
+      new InputEvent('input', {
+        bubbles: true,
+        inputType: 'insertText',
+        data: character
+      })
+    );
+    el.dispatchEvent(keyEvent('keyup', 'Unidentified', keyCode, modifiers));
+  }
+
+  test('a 229 "Unidentified" keydown before the text does not drop it', function (done) {
+    // Android soft keyboards announce every character with keydown key="Unidentified",
+    // keyCode 229. The ChromeOS guard used to swallow the character after it.
+    mq.focus();
+    softKey('x', 229);
+
+    tick(done, function () {
+      assert.equal(mq.latex(), 'x');
+      assert.equal(textarea().value, '', 'nothing may be left in the textarea');
+    });
+  });
+
+  test('several 229 characters arrive once each, in order', function (done) {
+    mq.focus();
+    softKey('y', 229);
+    setTimeout(function () {
+      softKey('=', 229);
+      setTimeout(function () {
+        softKey('2', 229);
+        tick(done, function () {
+          assert.equal(mq.latex(), 'y=2');
+        });
+      }, 10);
+    }, 10);
+  });
+
+  test('Ctrl-Shift-U Unicode entry is still ignored', function (done) {
+    mq.focus();
+    softKey('u', 85, { ctrlKey: true, shiftKey: true });
+
+    tick(done, function () {
+      assert.equal(mq.latex(), '', 'the spurious "u" of the Unicode entry');
+    });
+  });
+
+  test('a bare "Unidentified" keydown without 229 is still ignored', function (done) {
+    // The ChromeOS variant without modifiers.
+    mq.focus();
+    softKey('u', 0);
+
+    tick(done, function () {
+      assert.equal(mq.latex(), '');
+    });
+  });
 });
